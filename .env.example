# Copy to .env.local for local work, or set these in your host's dashboard.
# Both are optional in development and the app explains itself without them.

# Signs the visitor cookie behind saved destinations.
#   Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# REQUIRED in production. Without it the app falls back to a generated secret
# written into .data/, which does not survive a restart and is not shared
# between instances — so saved destinations would silently reset.
AMARA_SESSION_SECRET=

# Where the JSON store keeps bookings, messages and favourites.
# Defaults to ./.data. Point this at a mounted, persistent volume on any host
# whose filesystem is ephemeral, or leave it unset if you have swapped
# lib/server/store.ts for a real database.
AMARA_DATA_DIR=
